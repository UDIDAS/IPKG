mm:Anatomy a owl:Class ;
    rdfs:label "Anatomy" .

mm:Study a owl:Class ;
    rdfs:label "Study" .

mm:Series a owl:Class ;
    rdfs:label "Series" .

mm:AnatomicSite a owl:Class ;
    rdfs:label "AnatomicSite" ;
    rdfs:subClassOf mm:Anatomy .

mm:Organ a owl:Class ;
    rdfs:label "Organ" ;
    rdfs:subClassOf mm:Anatomy .

mm:Lesion a owl:Class ;
    rdfs:label "Lesion" .

mm:Observation a owl:Class ;
    rdfs:label "Observation" .

mm:OntologyConcept a owl:Class ;
    rdfs:label "OntologyConcept" .


# --- added 2026-09-14: renal tumor lesion class + verified concepts (parallel to LiverTumor / PancreaticTumor)
mm:RenalTumor a owl:Class ;
    rdfs:label "Renal tumor" ;
    mm:mapped_to_concept mm:concept_RenalTumor_126880001,
        mm:concept_RenalTumor_C3150 ;
    rdfs:subClassOf mm:Lesion ;
    skos:definition "Tumor located in the right or left kidney." .

mm:concept_RenalTumor_126880001 a mm:OntologyConcept ;
    mm:code "126880001" ;
    mm:display "Neoplasm of kidney" ;
    mm:system "SNOMED CT" ;
    rdfs:isDefinedBy <https://www.snomed.org/snomed-ct> ;
    rdfs:seeAlso <http://snomed.info/id/126880001> .

mm:concept_RenalTumor_C3150 a mm:OntologyConcept ;
    mm:code "C3150" ;
    mm:display "Kidney Neoplasm" ;
    mm:system "NCIt" ;
    rdfs:isDefinedBy <https://ncithesaurus.nci.nih.gov> ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/NCIT_C3150> .
