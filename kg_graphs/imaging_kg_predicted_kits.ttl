<http://example.org/mmkg/schema> a owl:Ontology ;
    dcterms:title "Imaging Phenotype KG Schema (SAM3 segmentation hand-off)" ;
    rdfs:comment "T-Box for imaging cases, organs, lesions and phenotypes derived from SAM3 segmentation. Domain classes carry skos:exactMatch to SNOMED CT / NCIt / FMA / RadLex concepts. Aligned with acm_mmkg schema.py v2.0 conventions." ;
    owl:versionInfo "1.0" .

mmkg:CrossOrganExtension a owl:Class ;
    rdfs:label "Cross-organ extension" ;
    mmkg:mapped_to_concept mmkg:concept_CrossOrganExtension_409771002 ;
    rdfs:subClassOf mmkg:Observation ;
    skos:exactMatch <http://snomed.info/id/409771002> .

mmkg:Liver a owl:Class ;
    rdfs:label "Liver" ;
    mmkg:mapped_to_concept mmkg:concept_Liver_10200004,
        mmkg:concept_Liver_C12392 ;
    rdfs:subClassOf mmkg:Organ ;
    skos:exactMatch <http://purl.obolibrary.org/obo/NCIT_C12392>,
        <http://snomed.info/id/10200004> .

mmkg:LiverTumor a owl:Class ;
    rdfs:label "Liver tumor" ;
    mmkg:mapped_to_concept mmkg:concept_LiverTumor_93870000,
        mmkg:concept_LiverTumor_C3099 ;
    rdfs:subClassOf mmkg:Lesion ;
    skos:exactMatch <http://purl.obolibrary.org/obo/NCIT_C3099>,
        <http://snomed.info/id/93870000> .

mmkg:Pancreas a owl:Class ;
    rdfs:label "Pancreas" ;
    mmkg:mapped_to_concept mmkg:concept_Pancreas_15776009,
        mmkg:concept_Pancreas_C12393 ;
    rdfs:subClassOf mmkg:Organ ;
    skos:exactMatch <http://purl.obolibrary.org/obo/NCIT_C12393>,
        <http://snomed.info/id/15776009> .

mmkg:PancreaticTumor a owl:Class ;
    rdfs:label "Pancreatic tumor" ;
    mmkg:mapped_to_concept mmkg:concept_PancreaticTumor_372003004,
        mmkg:concept_PancreaticTumor_C3305 ;
    rdfs:subClassOf mmkg:Lesion ;
    skos:exactMatch <http://purl.obolibrary.org/obo/NCIT_C3305>,
        <http://snomed.info/id/372003004> .

mmkg:TumorDiameter a owl:Class ;
    rdfs:label "Tumor diameter" ;
    mmkg:mapped_to_concept mmkg:concept_TumorDiameter_263605001 ;
    rdfs:subClassOf mmkg:Observation ;
    skos:exactMatch <http://snomed.info/id/263605001> .

mmkg:TumorVolume a owl:Class ;
    rdfs:label "Tumor volume" ;
    mmkg:mapped_to_concept mmkg:concept_TumorVolume_258261001 ;
    rdfs:subClassOf mmkg:Observation ;
    skos:exactMatch <http://snomed.info/id/258261001> .

mmkg:anatomic_location a owl:DatatypeProperty ;
    rdfs:label "anatomic_location" ;
    rdfs:range xsd:string .

mmkg:case_id a owl:DatatypeProperty ;
    rdfs:label "case_id" ;
    rdfs:range xsd:string .

mmkg:code a owl:AnnotationProperty ;
    rdfs:label "code" .

mmkg:dataset a owl:DatatypeProperty ;
    rdfs:label "dataset" ;
    rdfs:range xsd:string .

mmkg:depicts_organ a owl:ObjectProperty ;
    rdfs:label "depicts_organ" ;
    rdfs:domain mmkg:Series ;
    rdfs:range mmkg:Organ .

mmkg:diameter_mm a owl:DatatypeProperty ;
    rdfs:label "diameter_mm" ;
    rdfs:range xsd:float .

mmkg:dice_score a owl:DatatypeProperty ;
    rdfs:label "dice_score" ;
    rdfs:range xsd:float .

mmkg:display a owl:AnnotationProperty ;
    rdfs:label "display" .

mmkg:has_lesion a owl:ObjectProperty ;
    rdfs:label "has_lesion" ;
    rdfs:domain mmkg:Series ;
    rdfs:range mmkg:Lesion .

mmkg:has_observation a owl:ObjectProperty ;
    rdfs:label "has_observation" ;
    rdfs:domain mmkg:Lesion ;
    rdfs:range mmkg:Observation .

mmkg:has_series a owl:ObjectProperty ;
    rdfs:label "has_series" ;
    rdfs:domain mmkg:Study ;
    rdfs:range mmkg:Series .

mmkg:has_study a owl:ObjectProperty ;
    rdfs:label "has_study" ;
    rdfs:domain mmkg:ImagingCase ;
    rdfs:range mmkg:Study .

mmkg:is_tumor a owl:DatatypeProperty ;
    rdfs:label "is_tumor" ;
    rdfs:range xsd:boolean .

mmkg:lesion_count a owl:DatatypeProperty ;
    rdfs:label "lesion_count" ;
    rdfs:range xsd:integer .

mmkg:located_in a owl:ObjectProperty ;
    rdfs:label "located_in" ;
    rdfs:domain mmkg:Lesion ;
    rdfs:range mmkg:AnatomicSite .

mmkg:mapped_to_concept a owl:ObjectProperty ;
    rdfs:label "mapped_to_concept" ;
    rdfs:range mmkg:OntologyConcept .

mmkg:modality a owl:DatatypeProperty ;
    rdfs:label "modality" ;
    rdfs:range xsd:string .

mmkg:overlaps_organ a owl:ObjectProperty ;
    rdfs:label "overlaps_organ" ;
    rdfs:domain mmkg:Lesion ;
    rdfs:range mmkg:Organ .

mmkg:part_of a owl:ObjectProperty ;
    rdfs:label "part_of" ;
    rdfs:domain mmkg:AnatomicSite ;
    rdfs:range mmkg:Organ .

mmkg:source_of_segmentation a owl:DatatypeProperty ;
    rdfs:label "source_of_segmentation" ;
    rdfs:range xsd:string .

mmkg:system a owl:AnnotationProperty ;
    rdfs:label "system" .

mmkg:volume_cm3 a owl:DatatypeProperty ;
    rdfs:label "volume_cm3" ;
    rdfs:range xsd:float .

