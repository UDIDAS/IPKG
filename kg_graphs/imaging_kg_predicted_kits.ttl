inst:lesion_case_00006_kidney a mmkg:Lesion,
        mmkg:RenalTumor ;
    mmkg:at_site inst:site_body ;
    mmkg:has_observation inst:obs_case_00006_kidney_burden_cat,
        inst:obs_case_00006_kidney_containment,
        inst:obs_case_00006_kidney_multiplicity ;
    mmkg:is_tumor true ;
    mmkg:located_in inst:organ_case_00006_kidney ;
    mmkg:mapped_to_concept inst:concept_SNOMEDCT_126880001 ;
