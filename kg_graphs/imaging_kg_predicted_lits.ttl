inst:lesion_volume-101_liver a mmkg:Lesion,
        mmkg:LiverTumor ;
    mmkg:at_site inst:site_body ;
    mmkg:has_observation inst:obs_volume-101_liver_burden_cat,
        inst:obs_volume-101_liver_containment,
        inst:obs_volume-101_liver_multiplicity ;
    mmkg:is_tumor true ;
    mmkg:located_in inst:organ_volume-101_liver ;
    mmkg:mapped_to_concept inst:concept_SNOMEDCT_93870000 ;
    mmkg:volume_cm3 "106.28"^^xsd:float .

